# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# local Claude Code settings (machine-specific)
.claude/settings.local.json

# written by the checkmk puller on the server (and kept locally as a
# sample for testing) — committing it would ship stale numbers that the
# page would then present as live
status.json
# same for the spotify now-playing puller (server/spotify-nowplaying.py)
nowplaying.json
nowplaying-cover.jpg
# and the weather puller (server/weather.py)
weather.json
# puller secrets and its refresh token
server/.env
server/data/

# aperture output, generated locally — not part of the repo
/aperture/

# wrangler local state
worker/.wrangler/

# python bytecode
__pycache__/

# dev tooling for intro/ (the site itself needs no install)
node_modules/

# generated by tools/laptop; only the overview render is kept
tools/laptop/renders/*
!tools/laptop/renders/overview.png
tools/laptop/decal_*.png
tools/laptop/tex_*.png
tools/laptop/side_*.png
tools/laptop/print_bottom.png
tools/laptop/stickers_lid.png
*.blend1
