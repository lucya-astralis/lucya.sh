# from https://developer.spotify.com/dashboard → your app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# must be listed as a Redirect URI in the app settings; nothing has to run
# there, the code is copied from the browser's address bar during `auth`
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# weather location: a place name, looked up once at start. Add the ISO
# country code when the name exists in several countries.
WEATHER_PLACE=Tokyo
WEATHER_COUNTRY=JP
# or exact coordinates instead (these win over WEATHER_PLACE):
# WEATHER_LAT=35.69
# WEATHER_LON=139.69
# name shown on the page; defaults to the looked-up place name
# WEATHER_LABEL=Tokyo
# owner the containers write as (see compose.yaml)
PUID=1000
PGID=1000
